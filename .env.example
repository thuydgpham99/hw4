# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env — it is gitignored for a reason.

# Signs session tokens. Generate a fresh one per install:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-64-character-hex-string

# The agent's model, reached through the Portkey gateway (OpenAI-compatible).
PORTKEY_API_KEY=your-portkey-api-key
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_MODEL=gpt-5.6-luna
